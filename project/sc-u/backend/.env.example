# SC&U Backend — copy to .env and fill real values
#   cp .env.example .env
# Run API from this directory so python-dotenv finds .env:
#   uvicorn main:app --reload --port 8000

# Supabase (use service_role key on server only — never expose to frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Local LLM / embeddings (rag_service.py, embed_facilities.py)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: if switching chat/embeddings to Google Gemini later
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
