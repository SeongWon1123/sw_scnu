# =============================================================================
# SW 튜터링 프로그램 — 환경 변수 템플릿
# 사용법: 이 파일을 복사해 .env 를 만든 뒤 실제 값만 채우세요.
#   cp .env.example .env
# .env 는 git에 올리지 않습니다. (.gitignore)
# HWP / PDF 등 제출·안내 문서는 docs/ 아래에 그대로 보관합니다.
# =============================================================================

# --- App ---
APP_NAME=SW Tutoring
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
# 세션/암호화용. 배포 전 반드시 교체
SECRET_KEY=replace-with-a-long-random-string

# --- Database ---
# 예: postgresql://user:password@localhost:5432/sw_tutoring
#     sqlite:///./data/sw_tutoring.db
DATABASE_URL=sqlite:///./data/sw_tutoring.db

# --- Auth ---
JWT_SECRET=replace-with-another-long-random-string
JWT_EXPIRES_IN=7d

# --- Documents (HWP / PDF 유지) ---
# Desktop의 안내·양식 파일은 docs/ 에 두고 경로만 맞춥니다.
DOCS_DIR=./docs
ALLOWED_DOC_EXTENSIONS=.hwp,.hwpx,.pdf,.doc,.docx
UPLOAD_MAX_SIZE_MB=20

# --- Optional integrations ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ADMIN_EMAIL=
# ADMIN_PASSWORD=
